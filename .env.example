# StrideFit AI proxy config. Copy this file to ".env" and fill in your key.
# ".env" is gitignored — your key is never committed.

# Get a key at https://openrouter.ai/keys  — put the REAL key in .env, NOT here.
OPENROUTER_API_KEY=

# Any model id from https://openrouter.ai/models. Defaults to a small, recent model;
# if this exact id isn't on your account, pick another (e.g. openai/gpt-4o-mini).
OPENROUTER_MODEL=openai/gpt-5-mini

# Port the local proxy listens on.
AI_PROXY_PORT=8787

# Where the app finds the AI proxy. Accepts a bare origin/base URL (e.g.
# http://localhost:8787, trailing slash OK) or a full .../api/explain URL —
# the app derives both /api/explain and /api/coach from whichever you set.
EXPO_PUBLIC_AI_PROXY_URL=http://localhost:8787

# Rate limit (protects your key/cost): requests per IP per minute, global per minute.
AI_RL_PER_IP=10
AI_RL_GLOBAL=60

# Optional shared secret. When set, every request must send it in an
# x-proxy-token header (401 otherwise). Leave empty for open local dev.
PROXY_AUTH_TOKEN=

# The app-side half of PROXY_AUTH_TOKEN — set BOTH to the same value when the
# proxy enforces it (the app sends this as x-proxy-token). Empty = no header.
EXPO_PUBLIC_AI_PROXY_TOKEN=

# Optional CORS lock: only this origin may call the proxy from a browser.
# Leave empty for * (any origin) during local dev.
ALLOWED_ORIGIN=

# Set to 1 ONLY when the proxy runs behind a real reverse proxy that sets
# X-Forwarded-For; otherwise clients could pick their own rate-limit IP.
TRUST_PROXY=
