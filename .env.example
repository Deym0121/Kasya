# Kasya app config. Copy this file to ".env" and fill in your keys.
# ".env" is gitignored — your key is never committed.

# Get a key at https://openrouter.ai/keys  — put the REAL key in .env, NOT here.
OPENROUTER_API_KEY=

# Any model id from https://openrouter.ai/models. Defaults to a small, recent model;
# if this exact id isn't on your account, pick another (e.g. openai/gpt-4o-mini).
OPENROUTER_MODEL=openai/gpt-5-mini

# Port the local proxy listens on.
AI_PROXY_PORT=8787

# Host the proxy binds to. Defaults to 127.0.0.1 (loopback only) so the key-spending
# proxy isn't reachable across your LAN. Set 0.0.0.0 only if you must hit it from another device.
AI_PROXY_HOST=127.0.0.1

# The app calls this base for AI explanations + coaching (/api/explain, /api/coach).
EXPO_PUBLIC_AI_PROXY_URL=http://localhost:8787/api/explain

# Rate limit (protects your key/cost): requests per IP per minute, global per minute.
AI_RL_PER_IP=10
AI_RL_GLOBAL=60

# RevenueCat PUBLIC SDK keys (safe to ship in the app — they start appl_/goog_/test_).
# From app.revenuecat.com → your project → API keys. Billing stays in demo mode
# until a key is set AND the app runs as a native dev build (not Expo Go / web).
# EXPO_PUBLIC_REVENUECAT_KEY: a single key used on BOTH platforms (use for the
# Test Store key while testing). The per-platform keys below override it for
# production. NEVER put the RevenueCat SECRET key (sk_...) here or in the app.
EXPO_PUBLIC_REVENUECAT_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Supabase (Project Settings → API). URL + anon/publishable key are PUBLIC-safe —
# Row Level Security (supabase/migrations/0001_init.sql) is what protects the data.
# NEVER put the service_role or sb_secret_ key here or anywhere in the app — those
# bypass RLS and belong ONLY in Supabase Edge Function secrets (supabase secrets set).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 ONLY after the Apple provider is configured in Supabase (see
# SOCIAL_AUTH_SETUP.md + scripts/apple-secret.mjs). Until then the Apple button
# stays hidden so users never see a dead sign-in option. Must be 1 on iOS
# builds that ship social login (App Review guideline 4.8).
EXPO_PUBLIC_APPLE_SIGNIN=
