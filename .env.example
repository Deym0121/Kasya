# StrideFit AI proxy config. Copy this file to ".env" and fill in your key.
# ".env" is gitignored — your key is never committed.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model id from https://openrouter.ai/models (cheap, reliable default below).
OPENROUTER_MODEL=openai/gpt-4o-mini

# Port the local proxy listens on.
AI_PROXY_PORT=8787

# The app calls this URL for AI explanations (must match the proxy port).
EXPO_PUBLIC_AI_PROXY_URL=http://localhost:8787/api/explain
